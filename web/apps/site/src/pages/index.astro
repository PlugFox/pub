---
import { t } from "@pub/i18n";
import { common } from "@pub/i18n/generated/common";
import { buttonVariants } from "@pub/ui/button";
import { ThemeToggle } from "@pub/ui/theme-toggle";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title={t(common.siteTitle)} description={t(common.tagline)}>
  <header class="flex items-center justify-between border-b border-line px-6 py-3">
    <a href="/" class="font-semibold text-ink">{t(common.siteTitle)}</a>
    <ThemeToggle client:load />
  </header>
  <main class="mx-auto flex w-full max-w-2xl flex-col items-center gap-6 px-6 py-24 text-center">
    <h1 class="text-5xl font-bold tracking-tight text-ink">{t(common.siteTitle)}</h1>
    <p class="text-lg text-ink-muted">{t(common.tagline)}</p>
    <a href="/app" class={buttonVariants({ intent: "primary", size: "md" })}>
      {t(common.navApp)}
    </a>
  </main>
</BaseLayout>
