---
import { t } from "@pub/i18n";
import { common } from "@pub/i18n/generated/common";
import { landing } from "@pub/i18n/generated/landing";
import { buttonVariants } from "@pub/ui/button";
import { ThemePicker } from "@pub/ui/theme-picker";
import BaseLayout from "../layouts/base-layout.astro";

// Marketing landing (web/DESIGN.md “Mood”): welcoming SaaS, generous
// whitespace, hero gradient allowed here (and only here / marketing surfaces).
// GitHub URL is a placeholder until the public repository exists.
const GITHUB_URL = "https://github.com/PlugFox";

type Feature = { title: string; body: string; icon: string };
const features: Feature[] = [
  {
    title: t(landing.featurePrivateTitle),
    body: t(landing.featurePrivateBody),
    // Lock.
    icon: "M8 1.75a3.25 3.25 0 0 0-3.25 3.25V7h-.5A1.25 1.25 0 0 0 3 8.25v4.5C3 13.44 3.56 14 4.25 14h7.5c.69 0 1.25-.56 1.25-1.25v-4.5C13 7.56 12.44 7 11.75 7h-.5V5A3.25 3.25 0 0 0 8 1.75Zm1.75 5.25V5a1.75 1.75 0 1 0-3.5 0v2h3.5Z",
  },
  {
    title: t(landing.featureProxyTitle),
    body: t(landing.featureProxyBody),
    // Globe / sync arrows.
    icon: "M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM3 8a5 5 0 0 1 .77-2.66c.42.35.93.65 1.51.88A9.4 9.4 0 0 0 5 8c0 .62.1 1.22.28 1.78-.58.23-1.09.53-1.51.88A5 5 0 0 1 3 8Zm5 5a5 5 0 0 1-3.15-1.12c.3-.23.66-.44 1.08-.6A4.1 4.1 0 0 0 8 13Zm0-1.5c-.65 0-1.28-.62-1.62-1.72a7.9 7.9 0 0 1 3.24 0C9.28 10.88 8.65 11.5 8 11.5ZM6.5 8c0-.42.04-.83.11-1.2a7.9 7.9 0 0 0 2.78 0c.07.37.11.78.11 1.2s-.04.83-.11 1.2a7.9 7.9 0 0 0-2.78 0A6.6 6.6 0 0 1 6.5 8ZM8 3c.65 0 1.28.62 1.62 1.72a7.9 7.9 0 0 1-3.24 0C6.72 3.62 7.35 3 8 3Zm3.07 2.28c.42.16.78.37 1.08.6l.08.07A5 5 0 0 1 13 8a5 5 0 0 1-.77 2.66c-.42-.35-.93-.65-1.51-.88.18-.56.28-1.16.28-1.78s-.1-1.22-.28-1.78c.13-.05.25-.1.35-.14ZM4.93 4.28l.15-.11A5 5 0 0 1 8 3a4.1 4.1 0 0 0-2.07 1.28c.32.13.66.13 1 0Z",
  },
  {
    title: t(landing.featureOrgsTitle),
    body: t(landing.featureOrgsBody),
    // Key.
    icon: "M10.5 1.5A4 4 0 0 0 6.68 6.7L1.87 11.5a1.25 1.25 0 0 0-.37.89v1.36c0 .41.34.75.75.75h1.36c.33 0 .65-.13.88-.37l.36-.35a.75.75 0 0 0 .22-.53v-.75h.75c.2 0 .39-.08.53-.22l.72-.72a.75.75 0 0 0 .22-.53v-.53h.53c.2 0 .39-.08.53-.22l.95-.98A4 4 0 1 0 10.5 1.5Zm1 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z",
  },
  {
    title: t(landing.featureSelfHostTitle),
    body: t(landing.featureSelfHostBody),
    // Server box.
    icon: "M2 3.75C2 3.06 2.56 2.5 3.25 2.5h9.5c.69 0 1.25.56 1.25 1.25v2.5c0 .32-.12.61-.32.83.2.22.32.51.32.83v2.5c0 .32-.12.61-.32.83.2.22.32.51.32.83v.68c0 .69-.56 1.25-1.25 1.25h-9.5C2.56 14 2 13.44 2 12.75v-.68c0-.32.12-.61.32-.83a1.24 1.24 0 0 1-.32-.83v-2.5c0-.32.12-.61.32-.83A1.24 1.24 0 0 1 2 6.25v-2.5ZM3.5 4v2h9V4h-9Zm0 4.5v2h9v-2h-9Zm.75 3.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z",
  },
];
---

<BaseLayout title={t(common.siteTitle)} description={t(common.tagline)}>
  <header class="border-b border-line/60">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold text-ink">
        <img src="/icons/icon.svg" alt="" class="size-6" />
        {t(common.siteTitle)}
      </a>
      <nav class="flex items-center gap-2">
        <ThemePicker client:load />
        <a href="/app" class={buttonVariants({ intent: "outline", size: "sm" })}>
          {t(common.navApp)}
        </a>
      </nav>
    </div>
  </header>

  <main>
    {/* Hero — the ONLY surface allowed an accent-tinted gradient. */}
    <section class="bg-linear-to-b from-accent-soft/70 via-canvas to-canvas">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-6 px-6 pt-24 pb-20 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          {t(landing.heroTitle)}
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-ink-muted">
          {t(landing.heroSubtitle)}
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          <a href="/app" class={buttonVariants({ intent: "primary", size: "lg" })}>
            {t(landing.heroCta)}
          </a>
          <a
            href={GITHUB_URL}
            rel="noopener"
            class={buttonVariants({ intent: "outline", size: "lg" })}
          >
            {t(landing.heroCtaSecondary)}
          </a>
        </div>
        {/* Untranslated by design: a literal shell command, not UI prose. */}
        <code
          class="mt-6 rounded-lg border border-line bg-surface px-4 py-2 font-mono text-sm text-ink-muted"
        >
          dart pub token add https://pub.example.com/o/acme/pub
        </code>
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-6 py-20">
      <h2 class="text-center text-3xl font-semibold tracking-tight text-ink">
        {t(landing.featuresTitle)}
      </h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((feature) => (
            <article class="flex flex-col gap-3 rounded-xl border border-line bg-surface p-6">
              <span class="flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="size-5" fill="currentColor">
                  <path d={feature.icon} />
                </svg>
              </span>
              <h3 class="text-base font-semibold text-ink">{feature.title}</h3>
              <p class="text-sm leading-relaxed text-ink-muted">{feature.body}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="border-t border-line/60">
    <div
      class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-ink-muted sm:flex-row"
    >
      <p>{t(common.siteTitle)} — {t(landing.footerLicense)}</p>
      <a href={GITHUB_URL} rel="noopener" class="transition-colors hover:text-ink">
        {t(landing.footerGitHub)}
      </a>
    </div>
  </footer>
</BaseLayout>
