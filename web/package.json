{
  "name": "@pub/web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit -p packages/i18n && tsc --noEmit -p packages/ui && tsc --noEmit -p packages/api && tsc --noEmit -p packages/tokens && tsc --noEmit -p apps/site && biome check . && bun packages/tokens/scripts/contrast-check.ts",
    "build": "bun run --filter @pub/site build",
    "test": "bun test",
    "test:browser": "bun run --filter @pub/ui test:browser",
    "i18n:gen": "bun packages/i18n/scripts/i18n-gen.ts",
    "gen:api": "bun packages/api/scripts/gen-api.ts",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
