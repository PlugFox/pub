# Compose variables for docker/docker-compose.yml. Copy to docker/.env and adjust.
# Every infra variable has a default in the compose file — zero-config `up` works
# without this file for the pg/s3/redis/mail profiles. The full profile's app needs
# the secret material at the bottom. Dev-only values; never commit a real .env.

# --- PostgreSQL (profile: pg, full) ---
PUB_PG_USER=pub
PUB_PG_PASSWORD=pub_dev_password
PUB_PG_DB=pub
PUB_PG_PORT=5432

# --- MinIO / S3 (profile: s3, full) ---
# Root credentials double as the app's S3 access/secret key in the full profile.
# MinIO requires: user >= 3 chars, password >= 8 chars.
PUB_S3_ACCESS_KEY=pub-minio
PUB_S3_SECRET_KEY=pub_dev_password
PUB_S3_BUCKET=pub
PUB_S3_PORT=9000
PUB_S3_CONSOLE_PORT=9001

# --- Valkey / Redis-compatible KV (profile: redis, full) ---
PUB_REDIS_PORT=6379

# --- Mailpit dev mail sink (profile: mail, full) ---
PUB_MAIL_SMTP_PORT=1025
PUB_MAIL_UI_PORT=8025

# --- App (profile: full) ---
PUB_APP_PORT=8080

# --- App secret material (profile: full) ---
# The app container runs in PRODUCTION mode (S-25) and fails fast until these hold real
# values. Generate them once and append to docker/.env (gitignored — never commit it):
#
#   docker run --rm ghcr.io/plugfox/pub generate-secrets --format env >> docker/.env
#
# or, from a source checkout without the image:
#
#   (cd server && cargo run --bin pubd -- generate-secrets --format env) >> docker/.env
#
# The generated PUB_SERVER__MODE=production line is redundant here (compose already sets
# it on the app service) but harmless.
#PUB_AUTH__JWT__KID=
#PUB_AUTH__JWT__SIGNING_KEY=
#PUB_AUTH__OTP_PEPPER=
#PUB_AUTH__KEK=
