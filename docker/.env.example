# Compose variables for docker/docker-compose.yml. Copy to docker/.env and adjust.
# Every variable has a default in the compose file — zero-config `up` works without
# this file. Dev-only values; never commit a real .env.

# --- PostgreSQL (profile: pg, full) ---
PUB_PG_USER=pub
PUB_PG_PASSWORD=pub_dev_password
PUB_PG_DB=pub
PUB_PG_PORT=5432

# --- MinIO / S3 (profile: s3, full) ---
# Root credentials double as the app's S3 access/secret key in the full profile.
# MinIO requires: user >= 3 chars, password >= 8 chars.
PUB_S3_ACCESS_KEY=pub-minio
PUB_S3_SECRET_KEY=pub_dev_password
PUB_S3_BUCKET=pub
PUB_S3_PORT=9000
PUB_S3_CONSOLE_PORT=9001

# --- Valkey / Redis-compatible KV (profile: redis, full) ---
PUB_REDIS_PORT=6379

# --- App (profile: full) ---
PUB_APP_PORT=8080
